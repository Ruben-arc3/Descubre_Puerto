generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ALCALDIA_ADMIN
  BUSINESS_OWNER
  TOURIST

  @@map("user_role")
}

enum AuthProviderType {
  LOCAL
  GOOGLE

  @@map("auth_provider_type")
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("business_status")
}

enum OccupancyStatusType {
  AVAILABLE
  LIMITED
  FULL

  @@map("occupancy_status_type")
}

enum InquiryStatusType {
  SENT_TO_WHATSAPP
  CONFIRMED
  CANCELLED

  @@map("inquiry_status_type")
}

enum AnalyticsEventType {
  PAGE_VIEW
  WHATSAPP_CLICK
  QR_SCAN
  MAP_PIN_CLICK

  @@map("analytics_event_type")
}

model User {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String           @map("full_name") @db.VarChar(150)
  email        String           @unique @db.VarChar(255)
  passwordHash String?          @map("password_hash")
  authProvider AuthProviderType @default(LOCAL) @map("auth_provider")
  phone        String?          @db.VarChar(30)
  role         UserRole         @default(TOURIST)
  isActive     Boolean          @default(true) @map("is_active")
  googleId     String?          @unique @map("google_id") @db.VarChar(255)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  businesses Business[]
  inquiries  ReservationInquiry[]
  favorites  Favorite[]
  reviews    Review[]
  galleryPhotos GalleryPhoto[]
  galleryLikes  GalleryLike[]

  @@index([role], map: "idx_users_role")
  @@map("users")
}

// Fotos aportadas por la comunidad; el archivo original vive en PostgreSQL.
model GalleryPhoto {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  caption      String   @default("") @db.VarChar(250)
  category     String   @default("Playas y mar") @db.VarChar(80)
  location     String   @default("Puerto Escondido") @db.VarChar(150)
  imageData    Bytes    @map("image_data")
  mimeType     String   @map("mime_type") @db.VarChar(100)
  originalName String   @map("original_name") @db.VarChar(255)
  isSample     Boolean  @default(false) @map("is_sample")
  sourceCredit String?  @map("source_credit") @db.VarChar(255)
  sourceUrl    String?  @map("source_url") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes GalleryLike[]

  @@index([createdAt(sort: Desc)], map: "idx_gallery_photos_created")
  @@map("gallery_photos")
}

// Una fila por persona y foto; la restricción compuesta impide likes duplicados.
model GalleryLike {
  userId    String   @map("user_id") @db.Uuid
  photoId   String   @map("photo_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo GalleryPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([userId, photoId])
  @@index([photoId], map: "idx_gallery_likes_photo")
  @@map("gallery_likes")
}

model Category {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String @db.VarChar(100)
  slug         String @unique @db.VarChar(120)
  iconName     String @map("icon_name") @db.VarChar(50)
  displayOrder Int    @default(0) @map("display_order")

  businesses Business[]

  @@map("categories")
}

// Contenido editorial del destino, separado de los establecimientos comerciales.
model MunicipalityProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(160)
  department  String   @db.VarChar(120)
  tagline     String   @db.VarChar(220)
  introduction String
  history     String
  culture     String
  nature      String
  flora       String   @default("")
  fauna       String   @default("")
  places      String   @default("")
  geography   String   @default("")
  wikipediaSummary String? @map("wikipedia_summary")
  wikipediaUrl String? @map("wikipedia_url") @db.VarChar(500)
  wikipediaThumbnail String? @map("wikipedia_thumbnail") @db.VarChar(1000)
  wikipediaSyncedAt DateTime? @map("wikipedia_synced_at") @db.Timestamptz(6)
  coverImageUrl String? @map("cover_image_url")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  media MunicipalityMedia[]

  @@map("municipality_profiles")
}

// Archivo fotográfico del municipio; las fotos compartidas se conservan como BYTEA en PostgreSQL.
model MunicipalityMedia {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key          String   @unique @db.VarChar(120)
  caption      String   @db.VarChar(255)
  period       String   @default("Actualidad") @db.VarChar(80)
  imageUrl     String?  @map("image_url") @db.VarChar(1000)
  imageData    Bytes?   @map("image_data")
  mimeType     String?  @map("mime_type") @db.VarChar(100)
  credit       String?  @db.VarChar(255)
  sourceUrl    String?  @map("source_url") @db.VarChar(1000)
  isHistorical Boolean  @default(false) @map("is_historical")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  municipality MunicipalityProfile @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  municipalityId String @map("municipality_id") @db.Uuid

  @@index([municipalityId, isHistorical, displayOrder], map: "idx_municipality_media_gallery")
  @@map("municipality_media")
}

model Business {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String         @map("owner_id") @db.Uuid
  categoryId       String         @map("category_id") @db.Uuid
  name             String         @db.VarChar(180)
  slug             String         @unique @db.VarChar(200)
  zone             String         @db.VarChar(120)
  shortDescription String         @map("short_description") @db.VarChar(160)
  description      String
  whatsappNumber   String         @map("whatsapp_number") @db.VarChar(20)
  address          String         @db.VarChar(255)
  latitude         Decimal        @db.Decimal(10, 8)
  longitude        Decimal        @db.Decimal(11, 8)
  basePrice        Decimal?       @map("base_price") @db.Decimal(12, 2)
  priceUnit        String?        @map("price_unit") @db.VarChar(50)
  isFeatured       Boolean        @default(false) @map("is_featured")
  isVerified       Boolean        @default(false) @map("is_verified")
  status           BusinessStatus @default(PENDING)
  instagramUrl     String?        @map("instagram_url") @db.VarChar(255)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner         User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  accommodation AccommodationDetail?
  roomTypes     RoomType[]
  restaurantDetail RestaurantDetail?
  tourDetail TourDetail?
  media         BusinessMedia[]
  services      BusinessService[]
  menuItems     MenuItem[]
  inquiries     ReservationInquiry[]
  favorites     Favorite[]
  reviews       Review[]
  events        AnalyticsEvent[]

  @@index([categoryId, status], map: "idx_businesses_category_status")
  @@index([zone, status], map: "idx_businesses_zone_status")
  @@index([ownerId], map: "idx_businesses_owner")
  @@index([isFeatured], map: "idx_businesses_featured")
  @@map("businesses")
}

model AccommodationDetail {
  businessId       String              @id @map("business_id") @db.Uuid
  occupancyStatus  OccupancyStatusType @default(AVAILABLE) @map("occupancy_status")
  checkInTime      String?             @map("check_in_time") @db.VarChar(20)
  checkOutTime     String?             @map("check_out_time") @db.VarChar(20)
  maxGuestsPerUnit Int?                @map("max_guests_per_unit")
  amenities        String[]            @default([])
  smokingAllowed   Boolean             @default(false) @map("smoking_allowed")
  eventsAllowed    Boolean             @default(false) @map("events_allowed")
  petsPolicy       String              @default("NOT_ALLOWED") @map("pets_policy") @db.VarChar(40)
  statusUpdatedAt  DateTime            @default(now()) @map("status_updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([occupancyStatus], map: "idx_accommodation_occupancy")
  @@map("accommodation_details")
}

// Catálogo de unidades reservables de un alojamiento; cada tipo conserva su propia tarifa y reglas.
model RoomType {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId          String   @map("business_id") @db.Uuid
  name                String   @db.VarChar(160)
  description         String
  maxAdults           Int      @default(2) @map("max_adults")
  maxChildren         Int      @default(0) @map("max_children")
  bedDescription      String   @map("bed_description") @db.VarChar(180)
  areaSqm             Decimal? @map("area_sqm") @db.Decimal(7, 2)
  quantity            Int      @default(1)
  nightlyRate         Decimal  @map("nightly_rate") @db.Decimal(12, 2)
  breakfastIncluded   Boolean  @default(false) @map("breakfast_included")
  refundable          Boolean  @default(true)
  cancellationPolicy  String   @default("Cancelación flexible") @map("cancellation_policy") @db.VarChar(255)
  prepaymentPolicy    String   @default("Sin pago por adelantado") @map("prepayment_policy") @db.VarChar(255)
  amenities           String[] @default([])
  isAvailable         Boolean  @default(true) @map("is_available")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isAvailable], map: "idx_room_types_business_available")
  @@unique([businessId, name], map: "uq_room_types_business_name")
  @@map("room_types")
}

// Horarios, ambiente y capacidades para presentar de forma estructurada cada restaurante.
model RestaurantDetail {
  businessId       String   @id @map("business_id") @db.Uuid
  openingHours     Json     @default("{}") @map("opening_hours")
  closedDays       String[] @default([]) @map("closed_days")
  serviceOptions   String[] @default([]) @map("service_options")
  paymentMethods   String[] @default([]) @map("payment_methods")
  dietaryOptions   String[] @default([]) @map("dietary_options")
  atmosphere       String?  @db.VarChar(180)
  capacity         Int?
  averageSpend     Decimal? @map("average_spend") @db.Decimal(12, 2)
  reservationRequired Boolean @default(false) @map("reservation_required")
  accessibilityInfo String? @map("accessibility_info")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@map("restaurant_details")
}

// Logística y condiciones de las actividades guiadas o experiencias turísticas.
model TourDetail {
  businessId       String   @id @map("business_id") @db.Uuid
  durationMinutes  Int      @map("duration_minutes")
  schedules        String[] @default([])
  meetingPoint     String   @map("meeting_point") @db.VarChar(255)
  minGroupSize     Int      @default(1) @map("min_group_size")
  maxGroupSize     Int?     @map("max_group_size")
  minAge           Int?     @map("min_age")
  maxAge           Int?     @map("max_age")
  included         String[] @default([])
  requirements     String[] @default([])
  physicalLevel    String   @default("Suave") @map("physical_level") @db.VarChar(80)
  languages        String[] @default(["Español"])
  cancellationPolicy String @default("Consultar con el operador") @map("cancellation_policy") @db.VarChar(255)
  weatherPolicy    String?  @map("weather_policy") @db.VarChar(255)
  accessibilityInfo String? @map("accessibility_info")
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@map("tour_details")
}

model BusinessMedia {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  imageUrl     String?  @map("image_url")
  imageData    Bytes?   @map("image_data")
  mimeType     String?  @map("mime_type") @db.VarChar(100)
  fileName     String?  @map("file_name") @db.VarChar(255)
  isCover      Boolean  @default(false) @map("is_cover")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isCover], map: "idx_business_media_business_cover")
  @@map("business_media")
}

model BusinessService {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  name        String   @db.VarChar(160)
  description String?
  price       Decimal? @db.Decimal(12, 2)
  priceUnit   String?  @map("price_unit") @db.VarChar(50)
  isAvailable Boolean  @default(true) @map("is_available")
  displayOrder Int     @default(0) @map("display_order")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isAvailable], map: "idx_business_services_business_available")
  @@map("business_services")
}

model MenuItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  name        String   @db.VarChar(160)
  description String?
  category    String?  @db.VarChar(100)
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?  @map("image_url")
  isAvailable Boolean  @default(true) @map("is_available")
  displayOrder Int     @default(0) @map("display_order")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, category], map: "idx_menu_items_business_category")
  @@map("menu_items")
}

model Attraction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @db.VarChar(180)
  slug            String   @unique @db.VarChar(200)
  categoryTag     String   @map("category_tag") @db.VarChar(80)
  description     String
  recommendations String?
  latitude        Decimal  @db.Decimal(10, 8)
  longitude       Decimal  @db.Decimal(11, 8)
  coverImageUrl   String?  @map("cover_image_url")
  coverImageData  Bytes?   @map("cover_image_data")
  coverMimeType   String?  @map("cover_mime_type") @db.VarChar(100)
  isFeatured      Boolean  @default(false) @map("is_featured")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  events AnalyticsEvent[]

  @@map("attractions")
}

model ReservationInquiry {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String            @map("business_id") @db.Uuid
  touristId    String?           @map("tourist_id") @db.Uuid
  guestName    String            @map("guest_name") @db.VarChar(150)
  guestPhone   String?           @map("guest_phone") @db.VarChar(30)
  checkInDate  DateTime?         @map("check_in_date") @db.Date
  checkOutDate DateTime?         @map("check_out_date") @db.Date
  guestsCount  Int               @default(1) @map("guests_count")
  status       InquiryStatusType @default(SENT_TO_WHATSAPP)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tourist  User?    @relation(fields: [touristId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt(sort: Desc)], map: "idx_inquiries_business_created")
  @@index([touristId], map: "idx_inquiries_tourist")
  @@map("reservation_inquiries")
}

model Favorite {
  userId     String   @map("user_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, businessId])
  @@map("favorites")
}

model Review {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  rating     Int
  comment    String?
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId], map: "uq_user_business_review")
  @@index([businessId, createdAt(sort: Desc)], map: "idx_reviews_business_visible")
  @@map("reviews")
}

model AnalyticsEvent {
  id           BigInt             @id @default(autoincrement())
  businessId   String?            @map("business_id") @db.Uuid
  attractionId String?            @map("attraction_id") @db.Uuid
  eventType    AnalyticsEventType @map("event_type")
  sourceTag    String?            @map("source_tag") @db.VarChar(100)
  deviceType   String?            @map("device_type") @db.VarChar(30)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  business   Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  attraction Attraction? @relation(fields: [attractionId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc), eventType], map: "idx_analytics_created_event")
  @@index([businessId], map: "idx_analytics_business")
  @@index([sourceTag], map: "idx_analytics_source_tag")
  @@map("analytics_events")
}
